{
  "name": "myhealthopinions-website",
  "version": "3.3.0",
  "private": true,
  "description": "MyHealthOpinions — healthcare & consumer paid survey community website (React 19 + Vite, statically prerendered, 42 languages).",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "npm run chat-kb && vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "build:spa": "vite build",
    "build:server": "vite build --ssr src/entry-server.jsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "build:preview-html": "npm run chat-kb && vite build --mode singlefile",
    "check:seo": "node scripts/check-seo.mjs",
    "chat-kb": "node scripts/chat-kb.mjs",
    "wordcount": "node scripts/wordcount.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:extract": "node scripts/i18n-extract.mjs",
    "i18n:generate": "node scripts/i18n-generate.mjs",
    "qr:connect": "node scripts/generate-connect-qr.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "qrcode": "^1.5.4",
    "vite": "^7.1.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
