{
  "name": "myfrequentrewards-website",
  "private": true,
  "version": "1.0.0",
  "description": "MyFrequentRewards — earn money online by sharing your opinion in paid surveys. React + Vite with static prerendering for SEO.",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "node scripts/blog-meta.mjs && vite",
    "build": "node scripts/blog-meta.mjs && npm run build:client && npm run build:server && node scripts/prerender.mjs",
    "build:client": "vite build --outDir dist",
    "build:server": "vite build --ssr src/entry-server.jsx --outDir dist-ssr",
    "preview": "node scripts/serve.mjs dist",
    "serve": "node server/index.mjs",
    "seo:check": "node scripts/seo-check.mjs",
    "qr": "node scripts/generate-qr.mjs",
    "covers": "python3 scripts/generate-blog-covers.py",
    "build:preview": "node scripts/blog-meta.mjs && node scripts/build-preview.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "qrcode": "1.5.4",
    "vite": "6.4.4"
  }
}
