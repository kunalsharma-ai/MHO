# Copy to .env (local development) or .env.production (production build server) and fill in.
# Only variables starting with VITE_ are bundled into the website (Vite rule), and EVERYTHING in the
# bundle is public — never put passwords, API secrets or private keys here.
# (Older PUBLIC_* names from earlier versions of this project are still accepted.)

# Canonical domain used for canonical URLs, Open Graph, JSON-LD, sitemap.xml and robots.txt (no trailing slash)
VITE_SITE_URL=https://www.myhealthopinions.com

# Backend endpoints (served by your hosting/back-end, not by this repo). Relative paths are fine.
# Account endpoints = the working backend's /api/v1 routes (same ones web-1 uses). They must be reachable on THIS
# domain (reverse proxy), because the backend tells sites apart by the Host header and checks it against the login token.
VITE_REGISTER_URL=/api/v1/user
VITE_LOGIN_URL=/api/v1/user/login
VITE_RESEND_URL=/api/v1/user/resend
VITE_FORGOT_URL=/api/v1/forgot-password
VITE_CATEGORY_URL=/api/v1/category
VITE_ENQUIRY_URL=/api/enquiry
VITE_REVIEWS_URL=/api/reviews
# Optional JSON feed of real, consented reward redemptions for the reward pop-ups (leave empty to disable)
VITE_REWARD_FEED_URL=

# Google Analytics 4 measurement ID (loaded only after cookie consent), e.g. G-XXXXXXXXXX
VITE_GA4_ID=

# Minimum age for sign-up (the backend must enforce this too)
VITE_MIN_AGE=18

# ---------------------------------------------------------------------------------------------
# Dev/preview server settings (optional, NOT bundled into the website — no VITE_ prefix on purpose).
# Useful with Docker, WSL or a reverse proxy. Normal local development needs none of them.
# ---------------------------------------------------------------------------------------------
# DEV_HOST=0.0.0.0                      # default: listen on all interfaces (reachable from Docker/WSL)
# DEV_PORT=5173
# DEV_STRICT_PORT=true                  # fail instead of picking another port (use with Docker port mapping)
# DEV_USE_POLLING=true                  # hot reload on Docker Desktop / WSL bind mounts
# DEV_ALLOWED_HOSTS=localhost,my-gateway  # host names allowed through a proxy (default: any)
# DEV_HMR_CLIENT_PORT=80                # websocket port seen by the browser when proxied
# DEV_API_PROXY=https://your-working-domain   # forward /api/* to the backend in `npm run dev`. Needed for sign-up / log in to work in dev.
#                                              Use the SAME domain web-1 runs on: the backend reads the Host header to pick the site,
#                                              the e-mail settings and the login token, and the proxy forwards that host.
# VITE_PREVIEW_FORMS=true               # only if you want sign-up / log in to FAKE success (no request, no e-mail) for UI work

