# Copy to .env.local (never commit real values). Everything prefixed VITE_ ends up in the PUBLIC browser bundle.

# Canonical production origin, no trailing slash. Used for canonicals, sitemap, Open Graph and JSON-LD.
VITE_SITE_URL=https://www.myfrequentrewards.com

# Backend endpoints (served by your API / hosting backend, NOT this repository)
VITE_API_BASE_URL=
VITE_REGISTER_ENDPOINT=/api/register
VITE_CONTACT_ENDPOINT=/api/contact
VITE_REVIEW_ENDPOINT=/api/reviews

# Member portal (existing login / dashboard application). REQUIRED for production — e.g. https://member.myfrequentrewards.com/login
VITE_MEMBER_PORTAL_URL=

# Real, consented reward-activity feed (JSON array). Leave empty to hide activity toasts.
VITE_ACTIVITY_FEED_URL=
# Published reviews feed (JSON array). /api/reviews is served by server/index.mjs; the site falls back to
# /data/reviews.json automatically if the API isn't reachable (e.g. static-only hosting).
VITE_REVIEWS_FEED_URL=/api/reviews
# Optional live community figures for the home-page ledger (JSON with any of: rewardsPaidUsd,
# surveysCompletedThisMonth, monthlyAvailableSurveys, membersRegistered, asOf). Blank = use src/data/community.js
VITE_STATS_URL=

# Optional: Tawk.to property for the human hand-off inside Live Help (existing site already uses Tawk.to)
VITE_TAWK_PROPERTY_ID=
VITE_TAWK_WIDGET_ID=

# Optional: server-verified CAPTCHA (Cloudflare Turnstile site key). The SECRET key belongs on the server only.
VITE_TURNSTILE_SITE_KEY=

# Minimum age for sign-up (birth-year check). Business/legal decision — see README.
VITE_MIN_SIGNUP_AGE=18

# Preview builds only. NEVER set to true in production: it enables labelled preview activity data and simulated form success.
VITE_DEMO_MODE=false
# hash | browser  (hash is used only for the single-file HTML preview)
VITE_ROUTER=browser

# Login (pick ONE): JSON endpoint on your backend, or the member portal's own login URL for a classic form POST.
VITE_LOGIN_ENDPOINT=/api/login
VITE_LOGIN_FORM_ACTION=
# "Forgot password?" link (blank = contact page)
VITE_PASSWORD_RESET_URL=
