{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/(index.html|config.js)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/embed/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }, { "key": "Access-Control-Allow-Origin", "value": "*" }] },
    { "source": "/data/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }, { "key": "Access-Control-Allow-Origin", "value": "*" }] },
    { "source": "/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }, { "key": "Access-Control-Allow-Origin", "value": "*" }] },
    { "source": "/images/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] }
  ]
}
