<table
  width="100%"
  border="0"
  cellspacing="0"
  cellpadding="0"
  bgcolor="#f4f4f4"
  style="
    margin: 0;
    padding: 0;
    background: #f4f4f4;
    font-family: Arial, Helvetica, sans-serif;
  "
>
  <tr>
    <td align="center">
      <table
        width="920"
        border="0"
        cellspacing="0"
        cellpadding="0"
        bgcolor="#ffffff"
        style="
          max-width: 920px;
          width: 100%;
        "
      >
        <tr>
          <td height="12" bgcolor="#0D5CC7"></td>
        </tr>

        <tr>
          <td
            align="center"
            style="
              padding: 28px 20px 24px;
              background: #ffffff;
            "
          >
            <img
              src="https://myhealthopinions.com/images/logo/My-Health-Opinions.png"
              alt="My Health Opinions"
              width="420"
              style="
                display: block;
                max-width: 100%;
                height: auto;
                border: 0;
              "
            />
          </td>
        </tr>

        <tr>
          <td height="3" bgcolor="#FF7A00"></td>
        </tr>

        <tr>
          <td
            align="center"
            style="
              padding: 55px 40px 50px;
              background: #EAF3FF;
            "
          >
            <table
              border="0"
              cellspacing="0"
              cellpadding="0"
              align="center"
            >
              <tr>
                <td
                  style="
                    padding: 0 12px;
                    color: #FF7A00;
                    font-size: 28px;
                    font-weight: bold;
                  "
                >
                  •
                </td>

                <td
                  style="
                    padding: 0 12px;
                    color: #0D5CC7;
                    font-size: 38px;
                    font-weight: bold;
                  "
                >
                  •
                </td>

                <td
                  style="
                    padding: 0 12px;
                    color: #FFD199;
                    font-size: 24px;
                    font-weight: bold;
                  "
                >
                  •
                </td>

                <td
                  style="
                    padding: 0 12px;
                    color: #0A4DA5;
                    font-size: 32px;
                    font-weight: bold;
                  "
                >
                  •
                </td>

                <td
                  style="
                    padding: 0 12px;
                    color: #FF7A00;
                    font-size: 26px;
                    font-weight: bold;
                  "
                >
                  •
                </td>
              </tr>
            </table>

            <table
              width="110"
              height="110"
              border="0"
              cellspacing="0"
              cellpadding="0"
              align="center"
              style="
                margin-top: 12px;
                background: #ffffff;
                border: 3px solid #FF7A00;
                border-radius: 55px;
              "
            >
              <tr>
                <td
                  align="center"
                  valign="middle"
                  style="
                    color: #FF7A00;
                    font-size: 50px;
                    line-height: 110px;
                    font-weight: bold;
                  "
                >
                  ★
                </td>
              </tr>
            </table>

            <p
              style="
                margin: 28px 0 8px;
                color: #FF7A00;
                font-size: 18px;
                font-weight: bold;
                letter-spacing: 2px;
                text-transform: uppercase;
              "
            >
              It's Your Special Day
            </p>

            <h1
              style="
                margin: 0;
                color: #0D5CC7;
                font-size: 48px;
                line-height: 58px;
                font-weight: bold;
              "
            >
              Happy Birthday,
              <br />
              {{user.name.first}}!
            </h1>

            <p
              style="
                margin: 22px auto 0;
                max-width: 680px;
                color: #2a3940;
                font-size: 21px;
                line-height: 34px;
              "
            >
              Wishing you a wonderful birthday filled with
              happiness, memorable moments, and plenty of reasons
              to smile.
            </p>
          </td>
        </tr>

        <tr>
          <td style="padding: 40px 55px 20px;">
            <table
              width="100%"
              border="0"
              cellspacing="0"
              cellpadding="0"
              style="
                background: #ffffff;
                border: 1px solid #FFD199;
                border-radius: 16px;
              "
            >
              <tr>
                <td
                  width="180"
                  align="center"
                  valign="middle"
                  style="
                    padding: 35px 15px;
                    background: #FFF8F0;
                    border-radius: 16px 0 0 16px;
                  "
                >
                  <table
                    border="0"
                    cellspacing="0"
                    cellpadding="0"
                    align="center"
                  >
                    <tr>
                      <td
                        align="center"
                        style="
                          color: #FF7A00;
                          font-size: 58px;
                          line-height: 60px;
                          font-weight: bold;
                        "
                      >
                        ★
                      </td>
                    </tr>

                    <tr>
                      <td
                        align="center"
                        style="
                          padding-top: 8px;
                          color: #0D5CC7;
                          font-size: 16px;
                          font-weight: bold;
                          letter-spacing: 1px;
                        "
                      >
                        CELEBRATE
                      </td>
                    </tr>
                  </table>
                </td>

                <td
                  valign="middle"
                  style="
                    padding: 38px 40px;
                  "
                >
                  <h2
                    style="
                      margin: 0 0 14px;
                      color: #0D5CC7;
                      font-size: 28px;
                      line-height: 36px;
                    "
                  >
                    A Birthday Wish From Us
                  </h2>

                  <p
                    style="
                      margin: 0 0 18px;
                      color: #2a3940;
                      font-size: 18px;
                      line-height: 30px;
                    "
                  >
                    Today is all about celebrating
                    <strong>{{user.name.first}}</strong>.
                    We are delighted to have you as a valued member
                    of the
                    <span
                      style="
                        color: #FF7A00;
                        font-weight: bold;
                      "
                    >
                      My Health Opinions
                    </span>
                    community.
                  </p>

                  <p
                    style="
                      margin: 0;
                      color: #2a3940;
                      font-size: 18px;
                      line-height: 30px;
                    "
                  >
                    Thank you for being part of our community and
                    for sharing your valuable opinions with us.
                  </p>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <tr>
          <td style="padding: 20px 55px 35px;">
            <table
              width="100%"
              border="0"
              cellspacing="0"
              cellpadding="0"
              style="
                background: #0D5CC7;
                border-radius: 16px;
              "
            >
              <tr>
                <td
                  align="center"
                  style="
                    padding: 40px 35px;
                  "
                >
                  <p
                    style="
                      margin: 0 0 10px;
                      color: #FFD199;
                      font-size: 17px;
                      font-weight: bold;
                      letter-spacing: 1.5px;
                      text-transform: uppercase;
                    "
                  >
                    Here's to another great year
                  </p>

                  <h2
                    style="
                      margin: 0 0 14px;
                      color: #ffffff;
                      font-size: 30px;
                      line-height: 40px;
                    "
                  >
                    Keep sharing. Keep connecting. Keep celebrating.
                  </h2>

                  <p
                    style="
                      margin: 0 auto 25px;
                      max-width: 650px;
                      color: #EAF3FF;
                      font-size: 17px;
                      line-height: 28px;
                    "
                  >
                    We hope your special day is as rewarding as
                    being a part of the My Health Opinions community.
                  </p>

                  <a
                    href="https://www.myhealthopinions.com"
                    style="
                      display: inline-block;
                      background: #FF7A00;
                      color: #ffffff;
                      text-decoration: none;
                      padding: 15px 34px;
                      border-radius: 10px;
                      font-size: 17px;
                      font-weight: bold;
                      border: 1px solid #FFD199;
                    "
                  >
                    VISIT MY HEALTH OPINIONS
                  </a>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <tr>
          <td
            align="center"
            style="
              padding: 15px 60px 40px;
            "
          >
            <table
              border="0"
              cellspacing="0"
              cellpadding="0"
              align="center"
            >
              <tr>
                <td
                  height="3"
                  width="55"
                  bgcolor="#FF7A00"
                ></td>

                <td width="15"></td>

                <td
                  height="3"
                  width="55"
                  bgcolor="#0D5CC7"
                ></td>
              </tr>
            </table>

            <p
              style="
                margin: 20px 0 0;
                color: #0D5CC7;
                font-size: 21px;
                line-height: 32px;
                font-weight: bold;
                font-style: italic;
              "
            >
              "May your year ahead be filled with
              wonderful opportunities and happy moments."
            </p>
          </td>
        </tr>

              {% include "mailer/footer.liquid" %}
      </table>
    </td>
  </tr>
  <!-- BOTTOM ORANGE BAR -->
<tr>
<td
  height="8"
  bgcolor="#FF7A00"
  style="background:#FF7A00;"
></td>
</tr>
</table>