<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Parental Consent - My Health Opinions</title>
  </head>

  <body style="margin:0;padding:0;background:#f4f7fb;font-family:Arial,Helvetica,sans-serif;">

    <table
      width="100%"
      border="0"
      cellspacing="0"
      cellpadding="0"
      bgcolor="#f4f7fb"
      style="margin:0;padding:0;background:#f4f7fb;">
      <tr>
        <td align="center" style="padding:35px 15px;">

          <table
            width="680"
            border="0"
            cellspacing="0"
            cellpadding="0"
            bgcolor="#ffffff"
            style="
    width:680px;
    max-width:680px;
    background:#ffffff;
    border-radius:14px;
    overflow:hidden;
  ">

            <!-- TOP BLUE BAR -->
            <tr>
              <td
                height="8"
                bgcolor="#0D5CC7"
                style="background:#0D5CC7;"></td>
            </tr>

            <!-- LOGO -->
            <tr>
              <td align="center" style="padding:30px 25px 25px;background:#ffffff;">
                <img
                  src="https://myhealthopinions.com/images/logo/My-Health-Opinions.png"
                  alt="My Health Opinions"
                  width="320"
                  style="
    display:block;
    width:320px;
    max-width:90%;
    height:auto;
    border:0;
  " />
              </td>
            </tr>

            <!-- ORANGE ACCENT -->
            <tr>
              <td
                height="3"
                bgcolor="#FF7A00"
                style="background:#FF7A00;"></td>
            </tr>

            <!-- HERO -->
            <tr>
              <td align="center" style="padding:35px 40px 10px;">

                <h1 style="
    margin:22px 0 10px;
    font-size:30px;
    line-height:38px;
    font-weight:700;
    color:#0D5CC7;
  ">
                  Parental Consent Required
                </h1>

                <p style="
    margin:0;
    font-size:17px;
    line-height:28px;
    color:#5d6875;
  ">
                  Your approval is required for your child's participation.
                </p>

              </td>
            </tr>

            <!-- GREETING -->
            <tr>
              <td style="padding:30px 55px 10px;">

                <p style="
    margin:0 0 18px;
    font-size:21px;
    line-height:30px;
    font-weight:600;
    color:#25313d;
  ">
                  Dear {{ user.parent.name.first }},
                </p>

                <p style="
    margin:0 0 18px;
    font-size:16px;
    line-height:28px;
    color:#4b5865;
  ">
                  We hope this message finds you well.
                </p>

                <p style="
    margin:0;
    font-size:16px;
    line-height:28px;
    color:#4b5865;
  ">
                  Your child,
                  <strong style="color:#25313d;">{{ user.name.first }}</strong>,     
has registered on
                  <a
                    href="https://{{user.origin}}"
                    target="_blank"
                    style="color:#0D5CC7;text-decoration:none;font-weight:bold;">
                    MyHealthOpinions
                  </a>,     
an online survey and market research panel platform published by
Frequent Research Fieldwork Solutions Pvt. Ltd., and has indicated
that they are under the age of 18.
                </p>

              </td>
            </tr>

            <!-- ABOUT CARD -->
            <tr>
              <td style="padding:25px 55px;">

                <table
                  width="100%"
                  border="0"
                  cellspacing="0"
                  cellpadding="0"
                  style="
    border:1px solid #cfe0f5;
    border-radius:12px;
    background:#EAF3FF;
  ">
                  <tr>
                    <td style="padding:25px 28px;">

                      <p style="
    margin:0 0 12px;
    font-size:14px;
    font-weight:bold;
    text-transform:uppercase;
    letter-spacing:1px;
    color:#0D5CC7;
  ">
                        About MyHealthOpinions
                      </p>

                      <p style="
    margin:0;
    font-size:15px;
    line-height:25px;
    color:#4b5865;
  ">
                        <a
                          href="https://{{user.origin}}"
                          target="_blank"
                          style="color:#0D5CC7;text-decoration:none;font-weight:bold;">
                          MyHealthOpinions
                        </a>
                        allows members to participate in surveys and earn rewards by     
sharing opinions on various topics. We are committed to maintaining
a safe and secure environment for all participants, especially minors.
                      </p>

                    </td>
                  </tr>
                </table>

              </td>
            </tr>

            <!-- WHY RECEIVING -->
            <tr>
              <td style="padding:5px 55px 10px;">

                <h2 style="
    margin:0 0 12px;
    font-size:20px;
    line-height:28px;
    font-weight:700;
    color:#25313d;
  ">
                  Why You Are Receiving This Email
                </h2>

                <p style="
    margin:0;
    font-size:16px;
    line-height:28px;
    color:#4b5865;
  ">
                  During registration, your child provided your email address as the
                  <strong style="color:#25313d;">{{ user.parent.relation }}</strong>.     
In accordance with our Child Protection and Privacy Policy, we require
verified parental approval before allowing access to our platform.
                </p>

              </td>
            </tr>


            <!-- WHAT WE COLLECT -->
            <tr>
              <td style="padding:25px 55px 10px;">

                <h2 style="
    margin:0 0 12px;
    font-size:20px;
    line-height:28px;
    font-weight:700;
    color:#25313d;
  ">
                  What We Collect
                </h2>

                <p style="
    margin:0 0 12px;
    font-size:16px;
    line-height:28px;
    color:#4b5865;
  ">
                  With your consent, we may collect:
                </p>

                <table
                  width="100%"
                  border="0"
                  cellspacing="0"
                  cellpadding="0">
                  <tr>
                    <td
                      width="25"
                      valign="top"
                      style="padding:5px 0;font-size:18px;color:#0D5CC7;">
                      &#8226;
                    </td>
                    <td style="
    padding:5px 0;
    font-size:16px;
    line-height:25px;
    color:#4b5865;
  ">
                      Basic profile information (name, age, gender)
                    </td>
                  </tr>

                  <tr>
                    <td
                      width="25"
                      valign="top"
                      style="padding:5px 0;font-size:18px;color:#0D5CC7;">
                      &#8226;
                    </td>
                    <td style="
    padding:5px 0;
    font-size:16px;
    line-height:25px;
    color:#4b5865;
  ">
                      Survey participation responses
                    </td>
                  </tr>

                  <tr>
                    <td
                      width="25"
                      valign="top"
                      style="padding:5px 0;font-size:18px;color:#0D5CC7;">
                      &#8226;
                    </td>
                    <td style="
    padding:5px 0;
    font-size:16px;
    line-height:25px;
    color:#4b5865;
  ">
                      Reward-related details, if applicable
                    </td>
                  </tr>
                </table>

              </td>
            </tr>

            <!-- PARENT RIGHTS -->
            <tr>
              <td style="padding:25px 55px 10px;">

                <h2 style="
    margin:0 0 12px;
    font-size:20px;
    line-height:28px;
    font-weight:700;
    color:#25313d;
  ">
                  Your Rights as a Parent/Guardian
                </h2>

                <p style="
    margin:0 0 12px;
    font-size:16px;
    line-height:28px;
    color:#4b5865;
  ">
                  You have the right to:
                </p>

                <table
                  width="100%"
                  border="0"
                  cellspacing="0"
                  cellpadding="0">
                  <tr>
                    <td
                      width="25"
                      valign="top"
                      style="padding:5px 0;font-size:18px;color:#0D5CC7;">
                      &#8226;
                    </td>
                    <td style="
    padding:5px 0;
    font-size:16px;
    line-height:25px;
    color:#4b5865;
  ">
                      Review your child's information shared with us upon request by email
                    </td>
                  </tr>

                  <tr>
                    <td
                      width="25"
                      valign="top"
                      style="padding:5px 0;font-size:18px;color:#0D5CC7;">
                      &#8226;
                    </td>
                    <td style="
    padding:5px 0;
    font-size:16px;
    line-height:25px;
    color:#4b5865;
  ">
                      Withdraw consent at any time
                    </td>
                  </tr>

                  <tr>
                    <td
                      width="25"
                      valign="top"
                      style="padding:5px 0;font-size:18px;color:#0D5CC7;">
                      &#8226;
                    </td>
                    <td style="
    padding:5px 0;
    font-size:16px;
    line-height:25px;
    color:#4b5865;
  ">
                      Request account deletion
                    </td>
                  </tr>

                  <tr>
                    <td
                      width="25"
                      valign="top"
                      style="padding:5px 0;font-size:18px;color:#0D5CC7;">
                      &#8226;
                    </td>
                    <td style="
    padding:5px 0;
    font-size:16px;
    line-height:25px;
    color:#4b5865;
  ">
                      Contact us for any clarification
                    </td>
                  </tr>
                </table>

              </td>
            </tr>

            <!-- Verification CTA -->
            <tr>
              <td style="padding:25px 55px 20px;">
                <table
                  width="100%"
                  border="0"
                  cellspacing="0"
                  cellpadding="0"
                  style="
            background:#0D5CC7;
            border-radius:16px;
          ">
                  <tr>
                    <td align="center" style="
                padding:38px 35px;
              ">
                      <p style="
                margin:0 0 10px;
                color:#FFD199;
                font-size:17px;
                font-weight:bold;
                letter-spacing:1.5px;
                text-transform:uppercase;
              ">
                        Action Required
                      </p>

                      <h2 style="
                margin:0 0 14px;
                color:#ffffff;
                font-size:30px;
                line-height:40px;
              ">
                        Approve Your Child's Registration
                      </h2>

                      <p style="
                margin:0 auto 25px;
                max-width:650px;
                color:#EAF3FF;
                font-size:17px;
                line-height:28px;
              ">
                        Please verify that you are the legal parent or guardian   
                and approve your child's participation on
                MyHealthOpinions.
                      </p>

                      <a
                        href="https://{{user.origin}}/auth/parent-consent?user={{user._id}}&code={{otp.code}}"
                        target="_blank"
                        style="
                  display:inline-block;
                  background:#FF7A00;
                  color:#ffffff;
                  text-decoration:none;
                  padding:15px 40px;
                  border-radius:10px;
                  font-size:17px;
                  font-weight:bold;
                ">
                        VERIFY &amp; APPROVE
                      </a>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <!-- DIVIDER -->
            <tr>
              <td style="padding:10px 0;">

                <div style="
    height:1px;
    background:#e5e9ee;
  ">
</div>

              </td>
            </tr>
            {% include "mailer/footer.liquid" %}


            <!-- BOTTOM ORANGE BAR -->
            <tr>
              <td
                height="8"
                bgcolor="#FF7A00"
                style="background:#FF7A00;"></td>
            </tr>

          </table>

        </td>
      </tr>
    </table>

  </body>
</html>