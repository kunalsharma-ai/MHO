<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Change Email Address</title>
  </head>

  <body style="margin:0;padding:0;background:#f4f7fb;font-family:Arial,Helvetica,sans-serif;">

    <table
      width="100%"
      border="0"
      cellspacing="0"
      cellpadding="0"
      bgcolor="#f4f7fb"
      style="margin:0;padding:0;background:#f4f7fb;">
      <tr>
        <td align="center" style="padding:35px 15px;">

          <table
            width="680"
            border="0"
            cellspacing="0"
            cellpadding="0"
            bgcolor="#ffffff"
            style="width:680px;max-width:680px;background:#ffffff;border-radius:14px;overflow:hidden;">

            <!-- TOP BLUE BAR -->
            <tr>
              <td
                height="8"
                bgcolor="#0D5CC7"
                style="background:#0D5CC7;"></td>
            </tr>

            <!-- LOGO -->
            <tr>
              <td align="center" style="padding:30px 25px 25px;background:#ffffff;">
                <img
                  src="https://myhealthopinions.com/images/logo/My-Health-Opinions.png"
                  alt="My Health Opinions"
                  width="320"
                  style="display:block;width:320px;max-width:90%;height:auto;border:0;" />
              </td>
            </tr>

            <!-- ORANGE ACCENT -->
            <tr>
              <td
                height="3"
                bgcolor="#FF7A00"
                style="background:#FF7A00;"></td>
            </tr>

            <!-- HERO -->
            <tr>
              <td align="center" style="padding:35px 40px 10px;">

                <h1 style="
margin:22px 0 10px;
font-size:30px;
line-height:38px;
font-weight:700;
color:#0D5CC7;
">
                  Confirm Your Email Change
                </h1>

                <p style="
margin:0;
font-size:17px;
line-height:28px;
color:#5d6875;
">
                  One quick step is required to update your registered email address.
                </p>

              </td>
            </tr>

            <!-- GREETING -->
            <tr>
              <td style="padding:30px 55px 10px;">

                <p style="
margin:0 0 18px;
font-size:21px;
line-height:30px;
font-weight:600;
color:#25313d;
">
                  Hey {{ user.name.first }},
                </p>

                <p style="
margin:0;
font-size:16px;
line-height:28px;
color:#4b5865;
">
                  We received a request to change your registered email address on your  
MyHealthOpinions account. Please review the details below and confirm
the change if you made this request.
                </p>

              </td>
            </tr>

            <!-- EMAIL CHANGE CARD -->
            <tr>
              <td style="padding:25px 55px;">

                <table
                  width="100%"
                  border="0"
                  cellspacing="0"
                  cellpadding="0"
                  style="
border:1px solid #cfe0f5;
border-radius:12px;
background:#EAF3FF;
">

                  <tr>
                    <td style="padding:25px 28px;">

                      <p style="
margin:0 0 18px;
font-size:14px;
font-weight:bold;
text-transform:uppercase;
letter-spacing:1px;
color:#0D5CC7;
">
                        Email Address Change
                      </p>

                      <!-- CURRENT EMAIL -->
                      <table
                        width="100%"
                        border="0"
                        cellspacing="0"
                        cellpadding="0">
                        <tr>
                          <td width="120" style="
padding:8px 0;
font-size:15px;
color:#657383;
">
                            Current Email
                          </td>

                          <td style="
padding:8px 0;
font-size:16px;
font-weight:600;
color:#25313d;
">
                            {{ user.mail }}
                          </td>
                        </tr>

                        <!-- ARROW -->
                        <tr>
                          <td colspan="2" style="padding:3px 0;">
                            <div style="height:1px;background:#c9d9ed;"></div>
                          </td>
                        </tr>

                        <!-- NEW EMAIL -->
                        <tr>
                          <td width="120" style="
padding:8px 0;
font-size:15px;
color:#657383;
">
                            New Email
                          </td>

                          <td style="
padding:8px 0;
font-size:16px;
font-weight:700;
color:#0D5CC7;
">
                            {{ email }}
                          </td>
                        </tr>

                      </table>

                    </td>
                  </tr>

                </table>

              </td>
            </tr>

            <!-- MESSAGE -->
            <tr>
              <td style="padding:5px 55px 20px;">

                <p style="
margin:0;
font-size:16px;
line-height:28px;
color:#4b5865;
">
                  To confirm this change, click the button below. Your verification link  
will remain valid for
                  <strong style="color:#25313d;">24 hours</strong>.
                </p>

              </td>
            </tr>

            <!-- CTA -->
            <tr>
              <td align="center" style="padding:15px 55px 35px;">

                <a
                  href="https://{{user.origin}}/auth/change-email?updatecode={{token}}"
                  target="_blank"
                  style="
display:inline-block;
background:#FF7A00;
background-color:#FF7A00;
color:#ffffff;
text-decoration:none;
padding:16px 42px;
border-radius:8px;
font-size:17px;
font-weight:bold;
letter-spacing:.2px;
">
                  VERIFY EMAIL ADDRESS
                </a>

                <p style="
margin:15px 0 0;
font-size:13px;
line-height:20px;
color:#7b8794;
">
                  This link will expire after 24 hours.
                </p>

              </td>
            </tr>

            <!-- SECURITY NOTICE -->
            <tr>
              <td style="padding:0 55px 35px;">

                <table
                  width="100%"
                  border="0"
                  cellspacing="0"
                  cellpadding="0"
                  style="
border:1px solid #ffd199;
border-radius:10px;
background:#fff8ef;
">

                  <tr>
                    <td
                      width="70"
                      align="center"
                      style="padding:22px 10px 22px 20px;">

                      <table
                        border="0"
                        cellspacing="0"
                        cellpadding="0"
                        width="48"
                        height="48"
                        style="
width:48px;
height:48px;
background:#FFD199;
border-radius:50%;
">
                        <tr>
                          <td align="center" valign="middle">
                            <span style="font-size:22px;color:#E66400;font-weight:bold;">!</span>
                          </td>
                        </tr>
                      </table>

                    </td>

                    <td style="padding:22px 20px 22px 10px;">

                      <p style="
margin:0 0 7px;
font-size:16px;
font-weight:bold;
color:#25313d;
">
                        Didn't request this change?
                      </p>

                      <p style="
margin:0;
font-size:14px;
line-height:23px;
color:#5f6975;
">
                        You can safely ignore this email. Your registered email address  
will remain unchanged unless the verification link is used.
                      </p>

                    </td>
                  </tr>

                </table>

              </td>
            </tr>

            <!-- DIVIDER -->
            <tr>
              <td style="padding:10px 0;">
                <div style="height:1px;background:#e5e9ee;"></div>
              </td>
            </tr>

            {% include "mailer/footer.liquid" %}


            <!-- BOTTOM BAR -->
            <tr>
              <td
                height="8"
                bgcolor="#FF7A00"
                style="background:#FF7A00;"></td>
            </tr>

          </table>

        </td>
      </tr>
    </table>

  </body>
</html>