<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>New Caregiver Registration</title>
</head>

<body style="margin:0;padding:0;background:#f3f8f5;font-family:Arial,Helvetica,sans-serif;">

<table width="100%" border="0" cellspacing="0" cellpadding="0" bgcolor="#f3f8f5">
<tr>
<td align="center" style="padding:35px 15px;">

<table
  width="680"
  border="0"
  cellspacing="0"
  cellpadding="0"
  bgcolor="#ffffff"
  style="width:680px;max-width:680px;background:#ffffff;border-radius:14px;overflow:hidden;"
>

<!-- TOP GREEN BAR -->
<tr>
<td height="8" bgcolor="#269B62" style="background:#269B62;"></td>
</tr>

<!-- LOGO -->
<tr>
<td align="center" style="padding:30px 25px 25px;background:#ffffff;">
<img
  src="https://myhealthopinions.com/images/logo/My-Health-Opinions.png"
  alt="My Health Opinions"
  width="320"
  style="display:block;width:320px;max-width:90%;height:auto;border:0;"
/>
</td>
</tr>

<!-- ACCENT -->
<tr>
<td height="3" bgcolor="#269B62" style="background:#269B62;"></td>
</tr>

<!-- HERO -->
<tr>
<td align="center" style="padding:35px 40px 10px;">

<table border="0" cellspacing="0" cellpadding="0">
<tr>
<td
  align="center"
  valign="middle"
  width="72"
  height="72"
  bgcolor="#EAF7F1"
  style="width:72px;height:72px;background:#EAF7F1;border-radius:50%;"
>
<span style="font-size:30px;color:#269B62;font-weight:bold;">+</span>
</td>
</tr>
</table>

<h1
  style="
    margin:22px 0 10px;
    font-size:30px;
    line-height:38px;
    font-weight:700;
    color:#269B62;
  "
>
New Caregiver
</h1>

<p
  style="
    margin:0;
    font-size:17px;
    line-height:28px;
    color:#5d6875;
  "
>
A new caregiver has registered on MyHealthOpinions.
</p>

</td>
</tr>

<!-- GREETING -->
<tr>
<td style="padding:30px 55px 10px;">

<p
  style="
    margin:0 0 18px;
    font-size:21px;
    line-height:30px;
    font-weight:600;
    color:#25313d;
  "
>
Hello Admin,
</p>

<p
  style="
    margin:0;
    font-size:16px;
    line-height:28px;
    color:#4b5865;
  "
>
A new <strong style="color:#269B62;">Caregiver</strong>
has successfully registered on the MyHealthOpinions panel.
</p>

</td>
</tr>

<!-- REGISTRATION CARD -->
<tr>
<td style="padding:25px 55px;">

<table
  width="100%"
  border="0"
  cellspacing="0"
  cellpadding="0"
  style="
    border:1px solid #c7e7d7;
    border-radius:12px;
    background:#EAF7F1;
  "
>
<tr>
<td style="padding:25px 28px;">

<p
  style="
    margin:0 0 12px;
    font-size:14px;
    font-weight:bold;
    text-transform:uppercase;
    letter-spacing:1px;
    color:#269B62;
  "
>
Caregiver Registration
</p>

<p
  style="
    margin:0 0 20px;
    font-size:15px;
    line-height:25px;
    color:#4b5865;
  "
>
The following user has registered successfully:
</p>

<table width="100%" border="0" cellspacing="0" cellpadding="0">

<tr>
<td
  width="120"
  style="padding-bottom:10px;font-size:15px;font-weight:bold;color:#25313d;"
>
Name
</td>
<td
  style="padding-bottom:10px;font-size:15px;color:#4b5865;"
>
{{user.name.first}}
</td>
</tr>

<tr>
<td
  style="padding-bottom:10px;font-size:15px;font-weight:bold;color:#25313d;"
>
User ID
</td>
<td
  style="padding-bottom:10px;font-size:15px;color:#4b5865;"
>
{{user._id}}
</td>
</tr>

<tr>
<td
  style="font-size:15px;font-weight:bold;color:#25313d;"
>
User Type
</td>
<td
  style="font-size:15px;color:#269B62;font-weight:bold;"
>
Caregiver
</td>
</tr>

</table>

</td>
</tr>
</table>

</td>
</tr>

<!-- ADMIN NOTICE -->
<tr>
<td style="padding:5px 55px 35px;">

<table
  width="100%"
  border="0"
  cellspacing="0"
  cellpadding="0"
  style="
    border:1px solid #c7e7d7;
    border-radius:10px;
    background:#f4fbf7;
  "
>
<tr>
<td style="padding:22px 20px;">

<p
  style="
    margin:0 0 7px;
    font-size:16px;
    font-weight:bold;
    color:#25313d;
  "
>
New Registration Notification
</p>

<p
  style="
    margin:0;
    font-size:14px;
    line-height:23px;
    color:#5f6975;
  "
>
This notification was generated automatically after a new caregiver
registration. Please review the account in the admin panel if any further
action is required.
</p>

</td>
</tr>
</table>

</td>
</tr>

<!-- DIVIDER -->
<tr>
<td style="padding:0 55px;">
<div style="height:1px;background:#e5e9ee;"></div>
</td>
</tr>

<!-- SUPPORT -->
<tr>
<td align="center" style="padding:28px 55px 10px;">

<p style="margin:0;font-size:15px;line-height:25px;color:#66717e;">
Need help? Our support team is here to assist you.
</p>

<p style="margin:7px 0 0;font-size:15px;">
<a
  href="mailto:support@myhealthopinions.com"
  style="color:#269B62;text-decoration:none;font-weight:bold;"
>
support@myhealthopinions.com
</a>
</p>

</td>
</tr>

<!-- FOOTER -->
<tr>
<td style="padding:20px 35px 35px;">
{% include "mailer/footer.liquid" %}
</td>
</tr>

<!-- BOTTOM BAR -->
<tr>
<td height="8" bgcolor="#269B62" style="background:#269B62;"></td>
</tr>

</table>

</td>
</tr>
</table>

</body>
</html>
