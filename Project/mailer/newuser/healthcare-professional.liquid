<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>New Healthcare Professional Registration</title>
  </head>

  <body style="margin:0;padding:0;background:#f4f7fb;font-family:Arial,Helvetica,sans-serif;">

    <table
      width="100%"
      border="0"
      cellspacing="0"
      cellpadding="0"
      bgcolor="#f4f7fb">
      <tr>
        <td align="center" style="padding:35px 15px;">

          <table
            width="680"
            border="0"
            cellspacing="0"
            cellpadding="0"
            bgcolor="#ffffff"
            style="width:680px;max-width:680px;background:#ffffff;border-radius:14px;overflow:hidden;">

            <!-- TOP BLUE BAR -->
            <tr>
              <td
                height="8"
                bgcolor="#0D5CC7"
                style="background:#0D5CC7;"></td>
            </tr>

            <!-- LOGO -->
            <tr>
              <td align="center" style="padding:30px 25px 25px;background:#ffffff;">
                <img
                  src="https://myhealthopinions.com/images/logo/My-Health-Opinions.png"
                  alt="My Health Opinions"
                  width="320"
                  style="display:block;width:320px;max-width:90%;height:auto;border:0;" />
              </td>
            </tr>

            <!-- ACCENT -->
            <tr>
              <td
                height="3"
                bgcolor="#0D5CC7"
                style="background:#0D5CC7;"></td>
            </tr>

            <!-- HERO -->
            <tr>
              <td align="center" style="padding:35px 40px 10px;">

                <table
                  border="0"
                  cellspacing="0"
                  cellpadding="0">
                  <tr>
                    <td
                      align="center"
                      valign="middle"
                      width="72"
                      height="72"
                      bgcolor="#EAF3FF"
                      style="width:72px;height:72px;background:#EAF3FF;border-radius:50%;">
                      <span style="font-size:30px;color:#0D5CC7;font-weight:bold;">+</span>
                    </td>
                  </tr>
                </table>

                <h1 style="
    margin:22px 0 10px;
    font-size:30px;
    line-height:38px;
    font-weight:700;
    color:#0D5CC7;
  ">
                  New Healthcare Professional
                </h1>

                <p style="
    margin:0;
    font-size:17px;
    line-height:28px;
    color:#5d6875;
  ">
                  A new healthcare professional has registered on MyHealthOpinions.
                </p>

              </td>
            </tr>

            <!-- GREETING -->
            <tr>
              <td style="padding:30px 55px 10px;">

                <p style="
    margin:0 0 18px;
    font-size:21px;
    line-height:30px;
    font-weight:600;
    color:#25313d;
  ">
                  Hello Admin,
                </p>

                <p style="
    margin:0;
    font-size:16px;
    line-height:28px;
    color:#4b5865;
  ">
                  A new
                  <strong style="color:#0D5CC7;">Healthcare Professional</strong>
                  has successfully registered on the MyHealthOpinions panel.
                </p>

              </td>
            </tr>

            <!-- REGISTRATION CARD -->
            <tr>
              <td style="padding:25px 55px;">

                <table
                  width="100%"
                  border="0"
                  cellspacing="0"
                  cellpadding="0"
                  style="
    border:1px solid #cfe0f5;
    border-radius:12px;
    background:#EAF3FF;
  ">
                  <tr>
                    <td style="padding:25px 28px;">

                      <p style="
    margin:0 0 12px;
    font-size:14px;
    font-weight:bold;
    text-transform:uppercase;
    letter-spacing:1px;
    color:#0D5CC7;
  ">
                        Healthcare Professional Registration
                      </p>

                      <p style="
    margin:0 0 20px;
    font-size:15px;
    line-height:25px;
    color:#4b5865;
  ">
                        The following user has registered successfully:
                      </p>

                      <table
                        width="100%"
                        border="0"
                        cellspacing="0"
                        cellpadding="0">
                        <tr>
                          <td width="120" style="padding-bottom:10px;font-size:15px;font-weight:bold;color:#25313d;">
                            Name
                          </td>
                          <td style="padding-bottom:10px;font-size:15px;color:#4b5865;">
                            {{ user.name.first }}
                          </td>
                        </tr>

                        <tr>
                          <td style="padding-bottom:10px;font-size:15px;font-weight:bold;color:#25313d;">
                            User ID
                          </td>
                          <td style="padding-bottom:10px;font-size:15px;color:#4b5865;">
                            {{ user._id }}
                          </td>
                        </tr>

                        <tr>
                          <td style="font-size:15px;font-weight:bold;color:#25313d;">
                            User Type
                          </td>
                          <td style="font-size:15px;color:#0D5CC7;font-weight:bold;">
                            Healthcare Professional
                          </td>
                        </tr>
                      </table>

                    </td>
                  </tr>
                </table>

              </td>
            </tr>

            <!-- ADMIN NOTICE -->
            <tr>
              <td style="padding:5px 55px 35px;">

                <table
                  width="100%"
                  border="0"
                  cellspacing="0"
                  cellpadding="0"
                  style="
    border:1px solid #cfe0f5;
    border-radius:10px;
    background:#f8fbff;
  ">
                  <tr>

                    <td style="padding:22px 20px;">

                      <p style="
    margin:0 0 7px;
    font-size:16px;
    font-weight:bold;
    color:#25313d;
  ">
                        New Registration Notification
                      </p>

                      <p style="
    margin:0;
    font-size:14px;
    line-height:23px;
    color:#5f6975;
  ">
                        This notification was generated automatically after a new healthcare  
professional registration. Please review the account in the admin panel
if any further action is required.
                      </p>

                    </td>

                  </tr>
                </table>

              </td>
            </tr>

            <!-- DIVIDER -->
            <tr>
              <td style="padding:10px 0;">
                <div style="height:1px;background:#e5e9ee;"></div>
              </td>
            </tr>

            {% include "mailer/footer.liquid" %}


            <!-- BOTTOM BAR -->
            <tr>
              <td
                height="8"
                bgcolor="#0D5CC7"
                style="background:#0D5CC7;"></td>
            </tr>

          </table>

        </td>
      </tr>
    </table>

  </body>
</html>