<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Support Ticket Updated</title>
</head>

<body style="margin:0;padding:0;background:#f4f7fb;font-family:Arial,Helvetica,sans-serif;">

<table
  width="100%"
  border="0"
  cellspacing="0"
  cellpadding="0"
  bgcolor="#f4f7fb"
  style="margin:0;padding:0;background:#f4f7fb;"
>
<tr>
<td align="center" style="padding:35px 15px;">

<table
  width="680"
  border="0"
  cellspacing="0"
  cellpadding="0"
  bgcolor="#ffffff"
  style="
    width:680px;
    max-width:680px;
    background:#ffffff;
    border-radius:14px;
    overflow:hidden;
  "
>

<!-- TOP BLUE BAR -->
<tr>
<td
  height="8"
  bgcolor="#0D5CC7"
  style="background:#0D5CC7;"
></td>
</tr>

<!-- LOGO -->
<tr>
<td
  align="center"
  style="padding:30px 25px 25px;background:#ffffff;"
>
<img
  src="https://myhealthopinions.com/images/logo/My-Health-Opinions.png"
  alt="My Health Opinions"
  width="320"
  style="
    display:block;
    width:320px;
    max-width:90%;
    height:auto;
    border:0;
  "
/>
</td>
</tr>

<!-- ORANGE ACCENT -->
<tr>
<td
  height="3"
  bgcolor="#FF7A00"
  style="background:#FF7A00;"
></td>
</tr>

<!-- HERO -->
<tr>
<td
  align="center"
  style="padding:35px 40px 10px;"
>


<h1
  style="
    margin:22px 0 10px;
    font-size:30px;
    line-height:38px;
    font-weight:700;
    color:#0D5CC7;
  "
>
Support Ticket Updated
</h1>

<p
  style="
    margin:0;
    font-size:17px;
    line-height:28px;
    color:#5d6875;
  "
>
A response has been added to a support ticket.
</p>

</td>
</tr>

<!-- TICKET UPDATE -->
<tr>
<td style="padding:30px 55px 10px;">

<p
  style="
    margin:0 0 18px;
    font-size:21px;
    line-height:30px;
    font-weight:600;
    color:#25313d;
  "
>
Team Notification
</p>

<p
  style="
    margin:0;
    font-size:16px;
    line-height:28px;
    color:#4b5865;
  "
>
Support ticket
<strong style="color:#0D5CC7;">[{{reply.ticketNo}}]</strong>
has been updated by
<strong style="color:#25313d;">{{repliedBy.fullName}}</strong>.
Please review the latest response and take any necessary follow-up action.
</p>

</td>
</tr>

<!-- TICKET INFO -->
<tr>
<td style="padding:25px 55px;">

<table
  width="100%"
  border="0"
  cellspacing="0"
  cellpadding="0"
  style="
    border:1px solid #cfe0f5;
    border-radius:12px;
    background:#EAF3FF;
  "
>
<tr>
<td style="padding:25px 28px;">

<p
  style="
    margin:0 0 18px;
    font-size:14px;
    font-weight:bold;
    text-transform:uppercase;
    letter-spacing:1px;
    color:#0D5CC7;
  "
>
Ticket Update
</p>

<table width="100%" border="0" cellspacing="0" cellpadding="0">

<!-- TICKET NUMBER -->
<tr>
<td
  width="130"
  style="
    padding:8px 0;
    font-size:15px;
    color:#657383;
    vertical-align:top;
  "
>
Ticket No.
</td>

<td
  style="
    padding:8px 0;
    font-size:16px;
    font-weight:700;
    color:#0D5CC7;
    vertical-align:top;
  "
>
{{reply.ticketNo}}
</td>
</tr>

<!-- DIVIDER -->
<tr>
<td colspan="2" style="padding:3px 0;">
<div style="height:1px;background:#c9d9ed;"></div>
</td>
</tr>

<!-- UPDATED BY -->
<tr>
<td
  width="130"
  style="
    padding:8px 0;
    font-size:15px;
    color:#657383;
    vertical-align:top;
  "
>
Updated By
</td>

<td
  style="
    padding:8px 0;
    font-size:16px;
    font-weight:600;
    color:#25313d;
    vertical-align:top;
  "
>
{{repliedBy.fullName}}
</td>
</tr>

</table>

</td>
</tr>
</table>

</td>
</tr>

<!-- RESPONSE MESSAGE -->
<tr>
<td style="padding:5px 55px 20px;">

<p
  style="
    margin:0 0 12px;
    font-size:14px;
    font-weight:bold;
    text-transform:uppercase;
    letter-spacing:1px;
    color:#0D5CC7;
  "
>
Latest Response
</p>

<table
  width="100%"
  border="0"
  cellspacing="0"
  cellpadding="0"
  style="
    border-left:4px solid #0D5CC7;
    background:#f7f9fc;
  "
>
<tr>
<td
  style="
    padding:20px 22px;
    font-size:16px;
    line-height:28px;
    color:#4b5865;
  "
>
{{reply.message}}
</td>
</tr>
</table>

</td>
</tr>

<!-- ACTION NOTICE -->
<tr>
<td style="padding:15px 55px 35px;">

<table
  width="100%"
  border="0"
  cellspacing="0"
  cellpadding="0"
  style="
    border:1px solid #ffd199;
    border-radius:10px;
    background:#fff8ef;
  "
>
<tr>

<td
  width="70"
  align="center"
  style="padding:22px 10px 22px 20px;"
>

<table
  border="0"
  cellspacing="0"
  cellpadding="0"
  width="48"
  height="48"
  style="
    width:48px;
    height:48px;
    background:#FFD199;
    border-radius:50%;
  "
>
<tr>
<td align="center" valign="middle">

<span
  style="
    font-size:22px;
    color:#E66400;
    font-weight:bold;
  "
>
!
</span>

</td>
</tr>
</table>

</td>

<td style="padding:22px 20px 22px 10px;">

<p
  style="
    margin:0 0 7px;
    font-size:16px;
    font-weight:bold;
    color:#25313d;
  "
>
Action Required
</p>

<p
  style="
    margin:0;
    font-size:14px;
    line-height:23px;
    color:#5f6975;
  "
>
Please review the latest ticket response and update the ticket status
or take any required action.
</p>

</td>

</tr>
</table>

</td>
</tr>

<!-- DIVIDER -->
<tr>
<td style="padding:0 55px;">

<div
  style="
    height:1px;
    background:#e5e9ee;
  "
></div>

</td>
</tr>

<!-- TEAM FOOTER MESSAGE -->
<tr>
<td
  align="center"
  style="padding:28px 55px 10px;"
>

<p
  style="
    margin:0;
    font-size:15px;
    line-height:25px;
    color:#66717e;
  "
>
Please ensure the ticket is reviewed and handled appropriately.
</p>

</td>
</tr>

<!-- FOOTER -->
<tr>
<td style="padding:20px 35px 35px;">

{% include "mailer/footer.liquid" %}

</td>
</tr>

<!-- BOTTOM ORANGE BAR -->
<tr>
<td
  height="8"
  bgcolor="#FF7A00"
  style="background:#FF7A00;"
></td>
</tr>

</table>

</td>
</tr>
</table>

</body>
</html>