# Production image of the member and admin portal (Next.js), built from the Project folder:
#   docker compose build web-prod     (context ./Project, dockerfile web/Dockerfile.prod)
#
# The member area's "My Profile" and survey sections are separate packages (Project/sections/{hcp,caregiver,patient}).
# They are built here and served by Next from public/mho-sections, so the image always carries the bundles that match
# this commit. Project/web/public is not in git, so before this the image had no /mho-sections at all and every panel
# showed "Your panel's profile section could not be loaded" (2026-11-26).

FROM node:22-alpine AS sections
WORKDIR /src
COPY sections/hcp/package*.json sections/hcp/
COPY sections/caregiver/package*.json sections/caregiver/
COPY sections/patient/package*.json sections/patient/
RUN for p in hcp caregiver patient; do (cd sections/$p && npm ci --no-audit --no-fund --ignore-scripts) || exit 1; done
COPY sections ./sections
RUN node sections/tools/build-for-web.mjs /out/mho-sections

FROM node:22-alpine AS builder
WORKDIR /app
RUN apk add --no-cache libc6-compat
COPY web/package*.json ./
RUN npm install --no-audit --no-fund
COPY web/ .
RUN mkdir -p public
COPY --from=sections /out/mho-sections ./public/mho-sections
RUN npm run build

FROM node:22-alpine AS production
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/next.config.mjs ./next.config.mjs
EXPOSE 3000
CMD ["npm", "start"]
